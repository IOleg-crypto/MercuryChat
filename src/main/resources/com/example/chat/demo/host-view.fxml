<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="250.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: #1a1a24;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chat.demo.HostController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Text fill="#f4f4f6" strokeType="OUTSIDE" strokeWidth="0.0" text="Create Server">
         <font>
            <Font name="Cascadia Code SemiBold" size="18.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Text>

      <TextField fx:id="hostUsername" promptText="Your Nickname" style="-fx-background-color: #2b2b36; -fx-text-fill: white;" />

      <TextField fx:id="hostPort" promptText="Port" text="8080" style="-fx-background-color: #2b2b36; -fx-text-fill: white;" />

      <Button mnemonicParsing="false" onAction="#startServer" prefHeight="30.0" prefWidth="240.0" style="-fx-background-color: #5c5cff; -fx-text-fill: white; -fx-background-radius: 5;" text="Launch Server">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
   </children>
</VBox>